{
  "name": "cherry-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src test scripts vite.config.ts playwright.config.ts eslint.config.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,mjs,json,html}\" \".github/workflows/*.yml\" \"docs/v2/DEVELOPMENT_SETUP.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,mjs,json,html}\" \".github/workflows/*.yml\" \"docs/v2/DEVELOPMENT_SETUP.md\"",
    "boundaries": "node scripts/check-boundaries.mjs",
    "metrics": "node scripts/report-build-metrics.mjs",
    "static:verify": "node scripts/verify-static-build.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run boundaries && npm run test && npm run build",
    "release:check": "npm run check && npm run metrics && npm run static:verify && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
